{
  "name": "dsh-harness-ui",
  "version": "0.1.0",
  "description": "Full-page Harness console for the DeepSeek Harness Web GUI: sessions, plugins, market, MCP, skills and usage in one shell.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "web-ui",
    "console",
    "dashboard"
  ],
  "author": "jianjianzhu",
  "homepage": "https://github.com/jianjianzhu/dsh-harness-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jianjianzhu/dsh-harness-ui.git"
  },
  "bugs": {
    "url": "https://github.com/jianjianzhu/dsh-harness-ui/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "tests",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-slots"],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.1.6-alpha.2 <0.2.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node tests/smoke.mjs",
    "prepack": "npm run build && npm test"
  }
}
